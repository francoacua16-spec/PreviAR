# ─────────────────────────────────────────────────────────────
# PreviAR — Variables de entorno
# Copiá este archivo a `.env.local` y completá los valores.
# ─────────────────────────────────────────────────────────────

# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SOLO para el cron de limpieza (/api/cron/cleanup). Nunca lo expongas en el cliente.
# Dashboard > Project Settings > API > service_role (secreto)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Mapa: Leaflet + OpenStreetMap (tiles CARTO dark). No requiere API key.

# URL pública de la app (para links de WhatsApp y redirects)
# Local: http://localhost:3000 — Producción: https://previar.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto que protege el endpoint del cron (generá uno con: openssl rand -hex 32)
CRON_SECRET=cambia-esto-por-un-secreto-largo
